# Copy to .env.live (gitignored). Values never go into a chat, a log, a commit, or an issue.
# Path to a Windscribe Lagos WireGuard config file kept outside the repository; forward slashes on Windows.
WG_CONF_PATH=
# Brightdata proxy URL: http://USER:PASSWORD@brd.superproxy.io:44445 (the zone password, not the account password).
BRIGHTDATA_PROXY_URL=
